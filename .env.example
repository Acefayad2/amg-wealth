# Required before the admin CRM can persist data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Reserved for a future server-only Quo dispatcher; not required by the website API.
AMG_CRM_DATABASE_URL=
# Safer alternative when the saved password contains URI-reserved characters.
# The server combines it with AMG Portal's fixed transaction-pooler settings.
AMG_CRM_DATABASE_PASSWORD=

# Quo integration. Create a dedicated AMG key; never reuse another project's key.
QUO_API_KEY=
QUO_FROM_NUMBER=

# Keep false until an authorized production dispatch activation.
AMG_QUO_SEND_ENABLED=false
