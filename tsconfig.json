{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["netlify/functions/**/*.mts", "integrations/**/*.mts"],
  // Moved as-is from amg-practice-exam (never type-checked there); covered by
  // tests/learning-access.test.mjs and tests/learning.test.mjs instead.
  "exclude": ["netlify/functions/learning-access.mts", "netlify/functions/learning.mts"]
}
